<Solution>
  <Folder Name="/android/">
    <Project Path="src/android/Intercom.Android.Binding/Intercom.Android.Binding.csproj" />
    <!-- Optional add-on package; not a dependency of Plugin.Maui.Intercom. -->
    <Project Path="src/android/Intercom.Android.Ably/Intercom.Android.Ably.csproj" />
  </Folder>
  <!-- src/macios/Intercom.iOS.Binding is intentionally NOT part of the solution:
       it uses the SwiftBindings.Sdk project SDK and can only build on macOS with
       Xcode 26+. Build it explicitly with eng/generate-ios-binding.sh (macOS) or CI. -->
  <Folder Name="/Solution Items/">
    <File Path="../.editorconfig" />
    <File Path="../android.png" />
    <File Path="../README.md" />
    <File Path=".github/workflows/publish.yml" />
    <File Path="global.json" />
    <File Path="NuGet.Config" />
  </Folder>
  <Project Path="src/Plugin.Maui.Intercom/Plugin.Maui.Intercom.csproj" />
  <!-- net10.0 test project. It compiles the plugin's platform-neutral sources directly
       rather than referencing it: Plugin.Maui.Intercom only targets android and ios. -->
  <Project Path="src/tests/Plugin.Maui.Intercom.Tests/Plugin.Maui.Intercom.Tests.csproj" />
  <Project Path="src/sample/MauiSample.csproj">
    <Deploy />
  </Project>
</Solution>
