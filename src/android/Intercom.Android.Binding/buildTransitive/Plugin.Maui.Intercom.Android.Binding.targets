<?xml version="1.0" encoding="utf-8"?>
<!--
  Shipped in the Android binding package and imported automatically by any project
  that references it (directly or through Plugin.Maui.Intercom).

  Problem this solves:

  Intercom's Android SDK pulls in Jetpack Compose, and Xamarin.AndroidX.Compose.Runtime.Annotation
  publishes two variants that both define androidx.compose.runtime.Immutable / Stable:

      Xamarin.AndroidX.Compose.Runtime.Annotation.Android  -> aar/runtime-annotation-android.aar
      Xamarin.AndroidX.Compose.Runtime.Annotation.Jvm      -> jar/runtime-annotation-jvm.jar

  The .Jvm package adds its jar to @(AndroidJavaLibrary) whenever AndroidApplication is
  true, so an app that ends up with both on the graph fails to dex:

      Type androidx.compose.runtime.Immutable is defined multiple times

  Why it has to be fixed here and not by NuGet metadata:

  The remedy is an ExcludeAssets/PrivateAssets suppression, and a suppression describes one
  reference edge — it does not travel through NuGet dependency metadata the way a dependency
  id does. NuGet also unions assets across every path a package arrives by, so suppressing it
  on this package's edge does nothing about the edge from Compose.Runtime to the .Jvm variant
  in the consuming app. Without this file every consumer has to hand-add:

      <PackageReference Include="Xamarin.AndroidX.Compose.Runtime.Annotation.Jvm"
                        Version="..." ExcludeAssets="all" PrivateAssets="all" />

  Restore-time metadata cannot express that, but a build-time item removal can. Android wants
  the .Android variant, so the .Jvm jar is the one that goes.

  Set PluginMauiIntercomFixComposeAnnotationDuplicate=false to opt out (for example if you
  would rather manage the suppression yourself).
-->
<Project>

  <PropertyGroup>
    <PluginMauiIntercomFixComposeAnnotationDuplicate Condition=" '$(PluginMauiIntercomFixComposeAnnotationDuplicate)' == '' ">true</PluginMauiIntercomFixComposeAnnotationDuplicate>
  </PropertyGroup>

  <!--
    Hook placement matters. The dexer does NOT read @(AndroidJavaLibrary) directly:
    _DetermineJavaLibrariesToCompile (Xamarin.Android.Javac.targets) feeds it to the
    DetermineJavaLibrariesToCompile task, which produces @(_JavaLibrariesToCompile) ->
    @(_JavaLibrariesToCompileForApp), and that is what D8/R8 receive. So the removal has to
    happen before that target, not before _CompileDex — _CompileDex only gathers the
    finished .dex files, and its DependsOnTargets have already dexed by the time anything
    hooked BeforeTargets="_CompileDex" runs.

    _CheckDuplicateJavaLibraries and the two apk targets also read @(AndroidJavaLibrary),
    so they are covered too.

    This runs inside a target rather than as an evaluation-time ItemGroup because the .Jvm
    package adds its jar from its own imported targets and buildTransitive import order
    between two packages is not guaranteed.
  -->
  <Target Name="_PluginMauiIntercomRemoveDuplicateComposeRuntimeAnnotation"
          Condition=" '$(PluginMauiIntercomFixComposeAnnotationDuplicate)' == 'true' AND '$(AndroidApplication)' == 'true' "
          BeforeTargets="_DetermineJavaLibrariesToCompile;_CheckDuplicateJavaLibraries;_BuildApkEmbed;_BuildApkFastDev">
    <ItemGroup>
      <AndroidJavaLibrary Remove="@(AndroidJavaLibrary->WithMetadataValue('Filename','runtime-annotation-jvm'))" />
    </ItemGroup>
  </Target>

  <!--
    Suppress the broken Java Callable Wrapper (JCW) generated for
    AndroidX.Paging.AsyncPagedListDiffer+IPagedListListenerImplementor.

    Xamarin.AndroidX.Paging.Runtime emits a concrete JCW class
    (AsyncPagedListDiffer_PagedListListenerImplementor) that implements
    AsyncPagedListDiffer.PagedListListener but registers __md_methods = ""
    — so the generated Java stub has no implementation for onCurrentListChanged,
    making it invalid Java and causing a JAVAC compile error in every consuming app.

    The fix: remove Xamarin.AndroidX.Paging.Runtime.dll from the assembly list
    that _GenerateJavaStubs processes.  The native paging-runtime AAR is still
    present on the classpath (bundled via the package's build/ targets), so
    Intercom's Paging calls work at runtime.  The only effect is that no managed
    C# code in the consuming app can reference AndroidX.Paging types — which is
    fine because the plugin and sample never do.

    Set PluginMauiIntercomFixPagingJcw=false to opt out.
  -->
  <PropertyGroup>
    <PluginMauiIntercomFixPagingJcw Condition=" '$(PluginMauiIntercomFixPagingJcw)' == '' ">true</PluginMauiIntercomFixPagingJcw>
  </PropertyGroup>

  <!--
    Suppress the broken Java Callable Wrapper (JCW) generated for
    AndroidX.Paging.AsyncPagedListDiffer+IPagedListListenerImplementor.

    Xamarin.AndroidX.Paging.Runtime emits a concrete JCW class
    (AsyncPagedListDiffer_PagedListListenerImplementor) that implements
    AsyncPagedListDiffer.PagedListListener but registers __md_methods = ""
    — so the generated Java stub has no implementation for onCurrentListChanged,
    making it invalid Java and causing a JAVAC compile error in every consuming app.

    The fix: after _GenerateJavaStubs creates the stub, patch the file to add a
    no-op onCurrentListChanged so the class satisfies the Java interface contract.
    The __md_methods string remains empty, so no C# callback is invoked — this is
    intentional: the plugin and sample never register a managed PagedListListener,
    so the method is never called; the stub exists only to satisfy the compiler.

    Set PluginMauiIntercomFixPagingJcw=false to opt out.
  -->
  <PropertyGroup>
    <PluginMauiIntercomFixPagingJcw Condition=" '$(PluginMauiIntercomFixPagingJcw)' == '' ">true</PluginMauiIntercomFixPagingJcw>
  </PropertyGroup>

  <UsingTask TaskName="_PatchPagedListListenerJcw"
             TaskFactory="RoslynCodeTaskFactory"
             AssemblyFile="$(MSBuildToolsPath)\Microsoft.Build.Tasks.Core.dll">
    <ParameterGroup>
      <JcwFile ParameterType="System.String" Required="true" />
    </ParameterGroup>
    <Task>
      <Code Type="Fragment" Language="cs"><![CDATA[
        if (System.IO.File.Exists(JcwFile))
        {
            var content = System.IO.File.ReadAllText(JcwFile);
            // PagedList was removed from paging-runtime in Paging 3.x so it cannot
            // appear in a concrete method signature.  Making the JCW abstract allows
            // javac to accept the class without implementing the interface method.
            // The class is never instantiated from managed code (it has empty
            // __md_methods and our plugin never registers a managed PagedListListener),
            // so the abstract keyword has no runtime effect.
            if (!content.Contains("abstract class"))
            {
                content = content.Replace("public class AsyncPagedListDiffer_PagedListListenerImplementor",
                                          "public abstract class AsyncPagedListDiffer_PagedListListenerImplementor");
                System.IO.File.WriteAllText(JcwFile, content);
                Log.LogMessage(
                    Microsoft.Build.Framework.MessageImportance.Normal,
                    "Made PagedListListener JCW abstract: {0}", JcwFile);
            }
        }
      ]]></Code>
    </Task>
  </UsingTask>

  <Target Name="_PluginMauiIntercomPatchPagingJcw"
          Condition=" '$(PluginMauiIntercomFixPagingJcw)' == 'true' AND '$(AndroidApplication)' == 'true' "
          AfterTargets="_GenerateJavaStubs"
          BeforeTargets="_CompileJava">
    <ItemGroup>
      <_PagingBrokenJcwFiles Include="$(IntermediateOutputPath)android\src\**\AsyncPagedListDiffer_PagedListListenerImplementor.java" />
    </ItemGroup>
    <_PatchPagedListListenerJcw
        Condition="'@(_PagingBrokenJcwFiles)' != ''"
        JcwFile="%(_PagingBrokenJcwFiles.Identity)" />
  </Target>

</Project>
