  <!-- Package content -->
  <ItemGroup>
    <None Include="README.md" Pack="true" PackagePath="\" />
    <!-- Auto-imported by consumers (file name must match PackageId). Strips the duplicate
         Compose runtime-annotation jar that otherwise fails d8 in every consuming app;
         see the targets file for the full explanation.

         One entry per shipped TFM, spelled out rather than derived from
         $(TargetPlatformVersion): Pack metadata on a None item is collected from the
         OUTER build of a multi-targeted project, where $(TargetFramework) — and so the
         resolved platform version — is empty. NuGet needs the platform version in the
         folder name (NU1012), and a consumer whose TFM has no matching buildTransitive
         folder silently imports nothing and fails to dex, so a wrong path here is a
         quiet break rather than a loud one. Distinct PackagePaths, so the two entries
         do not collide as duplicate package files.

         The versions must track the TFM matrix in Directory.Build.props:
         net9.0-android -> 35.0, net10.0-android -> 36.0. -->
    <None Include="buildTransitive\Plugin.Maui.Intercom.Android.Binding.targets"
          Pack="true"
          PackagePath="buildTransitive\net9.0-android35.0\" />
    <None Include="buildTransitive\Plugin.Maui.Intercom.Android.Binding.targets"
          Pack="true"
          PackagePath="buildTransitive\net10.0-android36.0\" />
  </ItemGroup>
