<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <!-- net9.0-android;net10.0-android — see the TFM matrix note in Directory.Build.props. -->
    <TargetFrameworks>$(IntercomAndroidTargetFrameworks)</TargetFrameworks>

    <!-- Serialize the inner builds. DispatchToInnerBuilds passes this straight to its
         MSBuild task, and the two TFMs cannot run Gradle concurrently: every inner build
         invokes Gradle in the SAME project directory (src/android/native, the ToolPath of
         the AndroidGradleProject item) and differs only by an init script that redirects
         the build directory. $(_AGPOutDirAbs) is per-TFM, but src/android/native/.gradle
         is not, so two simultaneous `assembleRelease` runs share one project cache. In
         parallel the net10 build fails partway through resource compilation against paths
         under obj/Release/net9.0-android/:

             error XAGRDL0000: Resource compilation failed
               (obj\Release\net9.0-android\gradle\MauiIntercomRelease-08b8a\intermediates\
                verified_library_resources\release\verifyReleaseResources\compiled\
                anim_intercom_donothing.xml.flat (The system cannot find the path specified))

         Note the net9 path in an error attributed to the net10 inner build. Serialized,
         both TFMs build clean. -->
    <BuildInParallel>false</BuildInParallel>

    <!-- Deliberately NOT the default (the project name, 'Intercom.Android.Binding').
         RootNamespace decides where the generated Android Resource class lands, and the
         default put it in namespace Intercom.Android.Binding — which declares a namespace
         called `Intercom` in the GLOBAL namespace of every consuming app.

         C# simple-name lookup searches the members declared in each enclosing namespace
         before that level's using directives, so in a consumer the global `Intercom`
         namespace beat the `Intercom` class imported by `using Plugin.Maui.Intercom;`:

             Intercom.Default.Initialize(apiKey, appId);
             // error CS0234: The type or namespace name 'Default' does not exist
             //               in the namespace 'Intercom'

         Consumers had to fully qualify Plugin.Maui.Intercom.Intercom.Default or add an
         alias. iOS was never affected — its binding uses the namespace `IntercomBinding`
         and generates no Resource class. Pointing RootNamespace at the namespace the
         bound Java types already use keeps the global namespace clear. -->
    <RootNamespace>MauiIntercomAndroid</RootNamespace>
    <!-- API 23 (Android 6.0), not 21: AndroidX Emoji2 1.6.0 in the resolved graph declares
         minSdk 23, so a consuming app at 21 fails manifest merge outright. -->
    <SupportedOSPlatformVersion>23</SupportedOSPlatformVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <IsPackable>true</IsPackable>
    <!--
      Enable trim analyzers for Android class libraries.
      To learn more, see: https://learn.microsoft.com/dotnet/core/deploying/trimming/prepare-libraries-for-trimming
    -->
    <IsTrimmable>true</IsTrimmable>

    <!-- AndroidX Navigation is pinned per band, because the family's assembly names are
         not stable across it. 2.9.x split each package into a facade plus an `.Android`
         implementation, so the assembly MAUI 9 was compiled against —
         Xamarin.AndroidX.Navigation.Runtime, Version=1.0.0.0 — no longer exists under
         2.9.2.1. Forcing 2.9.2.1 onto a net9 app therefore breaks Microsoft.Maui.dll
         itself, not just this binding:

             error : Failed to load method 0x60011cd from '…/linked/Microsoft.Maui.dll'
               due to Could not load file or assembly
               'Xamarin.AndroidX.Navigation.Runtime, Version=1.0.0.0'

         Depending on where the build notices the missing assembly, that surfaces as an
         AOT failure or as a NullReferenceException inside GenerateJavaStubs — Cecil
         returns null for the unresolvable type and
         CustomAttributeProviderRocks.GetCustomAttributes dereferences it.

         2.8.9.1 is what MAUI 9 asks for, so the net9 band takes it and the long-standing
         NU1608 on this family disappears there as a side effect. MAUI 10 is built against
         2.9.x, so the net10 band keeps 2.9.2.1. -->
    <IntercomAndroidXNavigationVersion Condition="$(TargetFramework.StartsWith('net9.0'))">2.8.9.1</IntercomAndroidXNavigationVersion>
    <IntercomAndroidXNavigationVersion Condition="'$(IntercomAndroidXNavigationVersion)' == ''">2.9.2.1</IntercomAndroidXNavigationVersion>
    <!--
      NOTE: you can simply add .aar or .jar files in this directory to be included in the project.
      To learn more, see: https://learn.microsoft.com/dotnet/maui/migration/android-binding-projects
    -->
  </PropertyGroup>

  <!-- NuGet Package Properties -->
  <PropertyGroup>
    <PackageId>Plugin.Maui.Intercom.Android.Binding</PackageId>
    <Title>Intercom Android Bindings for Plugin.Maui.Intercom</Title>
    <Authors>kfrancis</Authors>
    <Description>Android native bindings for Intercom SDK. This package is a dependency of Plugin.Maui.Intercom.</Description>
    <Copyright>Copyright © kfrancis</Copyright>
    <PackageProjectUrl>https://github.com/kfrancis/Plugin.Maui.Intercom</PackageProjectUrl>
    <RepositoryUrl>https://github.com/kfrancis/Plugin.Maui.Intercom</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <PackageRequireLicenseAcceptance>True</PackageRequireLicenseAcceptance>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <PackageTags>dotnet-maui;maui;plugin;intercom;android;binding;</PackageTags>
    <GeneratePackageOnBuild>false</GeneratePackageOnBuild>
    <IncludeSymbols>true</IncludeSymbols>
    <SymbolPackageFormat>snupkg</SymbolPackageFormat>
    <Version>$(BindingPackageVersion)</Version>
  </PropertyGroup>

  <!-- Reference to Android project -->
  <ItemGroup>
    <AndroidGradleProject Include="../native/build.gradle.kts">
      <ModuleName>MauiIntercom</ModuleName>
      <Bind>true</Bind>
      <Pack>true</Pack>
    </AndroidGradleProject>
  </ItemGroup>

  <!-- 
    Exclude duplicate Compose Runtime Annotation packages to avoid D8/R8 class duplication error.
    Both .Android and .Jvm variants define the same classes (e.g., Immutable.class).
    We exclude the .Jvm variant since we're building for Android and need the .Android variant.
  -->
  <ItemGroup>
    <PackageReference Include="Xamarin.AndroidX.Compose.Runtime.Annotation.Jvm" Version="1.9.2" ExcludeAssets="all" PrivateAssets="all" />
  </ItemGroup>

  <!--
    Declared by the Intercom AARs' POMs but previously absent from this graph.
    The vendored classes reference them directly, so without these the messenger
    hits NoClassDefFoundError at runtime while the rest of the SDK works:
      androidx.work          → SendMessageWorker, ConversationReplyReceiver (push quick-reply)
      androidx.media3:ui     → PreviewUriKt (video attachment preview)
      kotlin-parcelize       → 22 @Parcelize model classes
    Versions track what intercom-sdk-base/-ui 17.4.1 ask for, and the Media3 and
    Kotlin versions already pinned below.
  -->
  <ItemGroup>
    <PackageReference Include="Xamarin.AndroidX.Work.Runtime" Version="2.9.1.1" />
    <PackageReference Include="Xamarin.AndroidX.Media3.UI" Version="1.6.1.1" />
    <PackageReference Include="Xamarin.Kotlin.Parcelize.Runtime" Version="2.2.20" />
  </ItemGroup>

  <!--
    Explicit pins that settle NU1608 constraint violations: each was being pulled
    in transitively at a version outside a sibling's declared range, which NuGet
    warns about and then resolves anyway. Aligning the whole Lifecycle family on
    2.9.4 removes them. Lifecycle.Service comes in via Work.Runtime above.

    Knowingly left in place: Xamarin.AndroidX.Emoji2.ViewsHelper 1.5.0.6 requires
    Emoji2 [1.5.0.6, 1.5.1) but AppCompat resolves Emoji2 1.6.0. Clearing it means
    moving ViewsHelper to 1.6.0.x, which demands Core 1.19 and Collection 1.6 —
    an AndroidX floor bump for the whole plugin.

    The alternative was pinning Emoji2 down to 1.5.0.6 to keep an API 21 floor.
    We took Emoji2 1.6.0 instead and raised SupportedOSPlatformVersion to 23,
    because Emoji2 1.6.0 declares minSdk 23 and an app at 21 fails manifest merge.
    So this warning is expected; the minimum supported Android is API 23.
  -->
  <ItemGroup>
    <PackageReference Include="Xamarin.AndroidX.Lifecycle.LiveData" Version="2.9.4" />
    <PackageReference Include="Xamarin.AndroidX.Lifecycle.LiveData.Ktx" Version="2.9.4" />
    <PackageReference Include="Xamarin.AndroidX.Lifecycle.LiveData.Core.Ktx" Version="2.9.4" />
    <PackageReference Include="Xamarin.AndroidX.Lifecycle.Process" Version="2.9.4" />
    <PackageReference Include="Xamarin.AndroidX.Lifecycle.Service" Version="2.9.4" />
  </ItemGroup>

