<!-- iOS binding for the Intercom SDK, generated by swift-dotnet-bindings
     (https://github.com/justinwojo/swift-dotnet-bindings).

     The SwiftBindings.Sdk MSBuild project SDK (version pinned in global.json under
     msbuild-sdks) discovers Intercom.xcframework in this directory, generates the
     C# binding + native wrapper at build time, and lays out the NuGet package
     (managed assemblies in lib/, native xcframeworks in runtimes/<rid>/native/,
     consumer wiring in buildTransitive/).

     Building this project requires macOS with Xcode 26+ and the .NET 10 iOS
     workload. Use eng/generate-ios-binding.sh for a reproducible local build,
     and eng/update-intercom.sh to move to a new pinned Intercom SDK version. -->
<Project Sdk="SwiftBindings.Sdk">
  <PropertyGroup>
    <!-- net9.0-ios;net10.0-ios — see the TFM matrix note in Directory.Build.props.

         SwiftBindings.Sdk documents a .NET 10 floor, but nothing in Sdk.props/Sdk.targets
         enforces the band: the SWIFTBIND010 gate matches on the platform substring
         (TargetFramework.Contains('ios')), the pack layout derives from
         $(TargetFramework) + $(TargetPlatformVersion), and this project runs the pure-ObjC
         lane, where the implicit SwiftBindings.Runtime and SwiftBindings.Apple package
         references are skipped outright — so there is no managed runtime assembly whose
         band has to match the consumer's. Generation runs once per inner build.
         Upstream question filed as
         https://github.com/justinwojo/swift-dotnet-bindings/issues/45 -->
    <TargetFrameworks>$(IntercomIosTargetFrameworks)</TargetFrameworks>
    <SupportedOSPlatformVersion>15.0</SupportedOSPlatformVersion>

    <!-- Bind Intercom's Objective-C surface only (pure-ObjC pipeline).
         Intercom is a mixed Swift/ObjC framework; its complete public API is
         exported through the ObjC umbrella header, which is all the plugin
         needs. The mixed pipeline's Swift/ObjC dedup removes shared classes
         (ICMUserAttributes, …) from the ObjC companion, so the plugin binds
         the ObjC surface directly instead. IsBindingProject engages the .NET
         iOS bgen pipeline for the generated ApiDefinition (SWIFTBIND004). -->
    <SwiftFrameworkType>ObjC</SwiftFrameworkType>
    <IsBindingProject>true</IsBindingProject>

    <!-- One consequence of the pure-ObjC lane is worth writing down, because the
         0.19.0 release notes lead with it as source-breaking and it looks like it
         should apply here.

         0.19.0 renames emitted ObjC types to the name Swift imports them under, so
         a header carrying NS_SWIFT_NAME emits under that name instead of the ObjC
         spelling. Intercom's Help Center headers all carry one — ICMHelpCenterArticle
         is HelpCenterArticle to Swift, ICMHelpCenterCollection is HelpCenterCollection
         — and the latter would collide head-on with this plugin's own
         Plugin.Maui.Intercom.HelpCenterCollection model.

         It does not happen. ObjCSwiftImportNameRewriter is driven by the rawObjCName ->
         swiftImportName map that SwiftABIParser harvests from the Swift ABI, and the two
         pure-ObjC ObjCPipeline.Run call sites in BindingsGeneratorCommand pass nothing
         for it (only the mixed path, after GenerateBindings, supplies one). An empty map
         makes the pass a no-op, so every type keeps its raw ObjC spelling and
         Intercom.macios.cs keeps naming ICMUserAttributes, ICMCompany and
         ICMHelpCenterCollection.

         Enum cases are a separate mechanism (StructsAndEnumsEmitter.ResolveCasePrefix)
         and DO strip here: a case set that repeats the enum's own type name at a
         PascalCase word boundary loses it, which is why ICMThemeOverrideLight is
         ICMThemeOverride.Light. Space's cases (home, helpCenter, …) carry neither the
         type name nor the module tag, so they only get PascalCased. -->
    <!-- SwiftBridgeRequired is deliberately not set: SWIFTBIND052 is gated on a SwiftUI
         bridge module having been built, and the pure-ObjC lane builds none. -->


    <!-- Ship the native payload as Intercom.iOS.Binding.resources.zip on every band.

         The default is 'auto' — compress only when the xcframework contains symlinks —
         and Intercom's does not, so the two bands disagreed: net10.0-ios26.0 packed a
         single .resources.zip while net9.0-ios18.0 packed a loose
         Intercom.iOS.Binding.resources/ directory tree. That cost 76 NU5123 warnings,
         one per entry NuGet considers too long, e.g.

           lib/net9.0-ios18.0/Intercom.iOS.Binding.resources/Intercom.xcframework/
             ios-arm64_x86_64-simulator/Intercom.framework/Modules/
             Intercom.swiftmodule/arm64-apple-ios-simulator.private.swiftinterface

         Extracted under a Windows consumer's ~/.nuget/packages that lands past MAX_PATH,
         so the warning is real and not cosmetic. Both bands' iOS SDKs consume either
         layout (_ReferencesWithNativeReferencesToExpand probes .resources and
         .resources.zip), so forcing the zip is the layout that works everywhere and
         keeps the two bands byte-comparable. -->
    <CompressBindingResourcePackage>true</CompressBindingResourcePackage>
  </PropertyGroup>

  <!-- NuGet Package Properties -->
  <PropertyGroup>
    <PackageId>Plugin.Maui.Intercom.iOS.Binding</PackageId>
    <Title>Intercom iOS Bindings for Plugin.Maui.Intercom</Title>
    <Authors>kfrancis</Authors>
    <Description>iOS native bindings for the Intercom SDK, generated with swift-dotnet-bindings. This package is a dependency of Plugin.Maui.Intercom.</Description>
    <Copyright>Copyright © kfrancis</Copyright>
    <PackageProjectUrl>https://github.com/kfrancis/Plugin.Maui.Intercom</PackageProjectUrl>
    <RepositoryUrl>https://github.com/kfrancis/Plugin.Maui.Intercom</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <PackageRequireLicenseAcceptance>True</PackageRequireLicenseAcceptance>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <PackageTags>dotnet-maui;maui;plugin;intercom;ios;binding;</PackageTags>
    <GeneratePackageOnBuild>false</GeneratePackageOnBuild>
    <Version>$(BindingPackageVersion)</Version>
  </PropertyGroup>

  <!-- No supplemental ApiDefinition/StructsAndEnums files.
       Up to SwiftBindings.Sdk 0.17.0 the ObjC pipeline's `-fmodules` retry made
       clang treat Intercom as a module, so `#import <Intercom/SiblingHeader.h>`
       inside the umbrella header collapsed into a module import and the ICM*
       classes, IntercomContent, and the Space/ContentType NS_ENUMs never reached
       the parse. Two hand-written supplement files covered the gap. 0.18.0 passes
       `-fmodule-name` on that retry so the framework's own headers parse
       textually and those declarations are generated — the supplements were
       removed with the 0.18.1 upgrade. See
       https://github.com/justinwojo/swift-dotnet-bindings/issues/44 -->

  <!-- Package content -->
  <ItemGroup>
    <None Include="README.md" Pack="true" PackagePath="\" />
  </ItemGroup>
</Project>
