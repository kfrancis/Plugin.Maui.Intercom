<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <LangVersion>latest</LangVersion>
    <OutputType>Exe</OutputType>
    <IsPackable>false</IsPackable>
    <IsPublishable>false</IsPublishable>
    <MinVerSkip>true</MinVerSkip>
    <!-- TUnit runs on Microsoft.Testing.Platform; the .NET 10 SDK refuses the old VSTest
         bridge, so `dotnet test` needs this to drive the test host directly. -->
    <TestingPlatformDotnetTestSupport>true</TestingPlatformDotnetTestSupport>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\Plugin.Maui.Intercom\Plugin.Maui.Intercom.csproj" />
  </ItemGroup>

  <!-- The coverage map is data under test; copy it next to the assembly. -->
  <ItemGroup>
    <None Include="..\..\..\eng\api-coverage.json" Link="api-coverage.json" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

  <ItemGroup>
    <!-- IntercomOptions.Bind takes an IConfiguration; the tests feed it an in-memory one.
         The plugin itself gets the abstraction from MAUI. -->
    <PackageReference Include="Microsoft.Extensions.Configuration" Version="10.0.0" />
    <!-- Property-based testing: exercises ComputeUserJwt/ComputeUserHash over a wide input
         space and stress-tests the unread observable's locking. Test-only; never shipped. -->
    <PackageReference Include="CsCheck" Version="4.8.0" />
    <PackageReference Include="TUnit" Version="1.63.0" />
  </ItemGroup>

</Project>
