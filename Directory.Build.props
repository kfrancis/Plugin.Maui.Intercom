<Project>
  <!-- Shared MSBuild properties for all projects in the src directory -->

  <!-- Shared version for all packages -->
  <PropertyGroup>
    <!-- 1.0.0: the v2 API surface is a breaking change (see MIGRATION.md). CI overrides this
         with the MinVer-computed version, so the release tag must be v1.0.0 or later. -->
    <IntercomPluginVersion Condition="'$(IntercomPluginVersion)' == ''">1.0.0</IntercomPluginVersion>
    <!-- Use Version if provided, otherwise use IntercomPluginVersion -->
    <BindingPackageVersion Condition="'$(Version)' != ''">$(Version)</BindingPackageVersion>
    <BindingPackageVersion Condition="'$(Version)' == ''">$(IntercomPluginVersion)</BindingPackageVersion>

    <!-- The iOS binding can only be built on macOS with Xcode, so a Windows or Linux
         developer has no way to produce it at the current version. Overriding this with an
         already-published version lets restore succeed so the Android TFM can be built;
         build.ps1 does exactly that. Never override it when packing — CI leaves it alone,
         which keeps the packed dependency pinned to the version being released. -->
    <IntercomIosBindingVersion Condition="'$(IntercomIosBindingVersion)' == ''">$(BindingPackageVersion)</IntercomIosBindingVersion>

    <!-- CI computes the version once (MinVer in the version job) and passes it as
         -p:Version to every build/pack. Skip the in-project MinVer run in that case,
         otherwise a shallow checkout without tags silently repacks as 0.0.0-alpha.0. -->
    <MinVerSkip Condition="'$(Version)' != ''">true</MinVerSkip>
  </PropertyGroup>

  <!-- Centrally pinned tool/SDK versions.
       Change these in one place; eng/ scripts and CI read them from here. -->
  <PropertyGroup>
    <!-- Intercom iOS SDK version vendored at src/macios/Intercom.iOS.Binding/Intercom.xcframework -->
    <IntercomIosSdkVersion>18.7.2</IntercomIosSdkVersion>
    <!-- Intercom Android SDK version vendored in src/android/Intercom.Android.Binding/Jars -->
    <IntercomAndroidSdkVersion>17.4.1</IntercomAndroidSdkVersion>
    <!-- Ably realtime closure vendored in src/android/Intercom.Android.Ably/Jars.
         Intercom Android's POM asks for io.ably:ably-android, but it only touches core
         ably-java types, so we vendor ably-java and avoid a Firebase Messaging dependency.
         Keep ably-java in step with what the pinned Intercom SDK expects. -->
    <AblyJavaSdkVersion>1.5.0</AblyJavaSdkVersion>
    <AblyNetworkClientVersion>1.5.0</AblyNetworkClientVersion>
    <MsgpackCoreVersion>0.8.11</MsgpackCoreVersion>
    <VcdiffCoreVersion>0.1.1</VcdiffCoreVersion>
    <!-- swift-dotnet-bindings MSBuild project SDK version is pinned in global.json (msbuild-sdks).
         This property mirrors it for scripts/CI that need the value without JSON parsing. -->
    <SwiftBindingsSdkVersion>0.18.1</SwiftBindingsSdkVersion>
  </PropertyGroup>
</Project>
