<Project>
  <!-- Shared MSBuild properties for all projects in the src directory -->

  <!-- Shared version for all packages -->
  <PropertyGroup>
    <!-- 0.9.0: the new API surface replaces the 0.7/0.8 one wholesale (see MIGRATION.md).
         Still 0.x deliberately — that carries no compatibility promise, which is what a
         breaking release needs while the surface is being shaken out on real devices.
         CI overrides this with the MinVer-computed version, so the release tag decides:
         tag v0.9.0 for this, and 1.0.0 once it has been validated. -->
    <IntercomPluginVersion Condition="'$(IntercomPluginVersion)' == ''">0.9.0</IntercomPluginVersion>
    <!-- Use Version if provided, otherwise use IntercomPluginVersion -->
    <BindingPackageVersion Condition="'$(Version)' != ''">$(Version)</BindingPackageVersion>
    <BindingPackageVersion Condition="'$(Version)' == ''">$(IntercomPluginVersion)</BindingPackageVersion>

    <!-- The iOS binding can only be built on macOS with Xcode, so a Windows or Linux
         developer has no way to produce it at the current version. Overriding this with an
         already-published version lets restore succeed so the Android TFM can be built;
         build.ps1 does exactly that. Never override it when packing — CI leaves it alone,
         which keeps the packed dependency pinned to the version being released. -->
    <IntercomIosBindingVersion Condition="'$(IntercomIosBindingVersion)' == ''">$(BindingPackageVersion)</IntercomIosBindingVersion>

    <!-- CI computes the version once (MinVer in the version job) and passes it as
         -p:Version to every build/pack. Skip the in-project MinVer run in that case,
         otherwise a shallow checkout without tags silently repacks as 0.0.0-alpha.0. -->
    <MinVerSkip Condition="'$(Version)' != ''">true</MinVerSkip>
  </PropertyGroup>

  <!-- Target framework matrix.

       Every shipped package multi-targets the net9.0 and net10.0 bands. The net9 band
       exists because .NET 9 is supported until 2026-11-10 and real consumers are still
       on it; a net9.0-ios app cannot restore a net10.0-ios lib, so shipping only net10
       locks them out entirely. Drop the net9 entries after that date.

       Both bands build from the .NET 10 SDK — the installed android/ios workloads carry
       the net9 reference packs, so no second SDK band is required on the build machine.
       Resolved platform versions (they decide the lib/ and buildTransitive/ pack paths):
         net9.0-android  -> 35.0      net10.0-android -> 36.0
         net9.0-ios      -> 18.0      net10.0-ios     -> 26.0

       Keep these lists in one place: the four package projects have to agree, and drift
       between them shows up as a consumer restore failure, not a build failure here.

       Overridable (hence the Conditions): a Windows or Linux developer has no way to
       produce the iOS binding at the current version, so build.ps1 narrows the plugin to
       the Android TFMs rather than failing restore on a package that cannot exist yet.
       Set them as environment variables or global properties — a semicolon-separated
       value does not survive `-p:` on the command line. -->
  <PropertyGroup>
    <IntercomIosTargetFrameworks Condition="'$(IntercomIosTargetFrameworks)' == ''">net9.0-ios;net10.0-ios</IntercomIosTargetFrameworks>
    <IntercomAndroidTargetFrameworks Condition="'$(IntercomAndroidTargetFrameworks)' == ''">net9.0-android;net10.0-android</IntercomAndroidTargetFrameworks>
    <IntercomPluginTargetFrameworks Condition="'$(IntercomPluginTargetFrameworks)' == ''">net9.0-android;net9.0-ios;net10.0-android;net10.0-ios</IntercomPluginTargetFrameworks>
  </PropertyGroup>

  <!-- MAUI version per band.

       $(MauiVersion) is supplied by the installed workload and tracks the SDK band
       (10.0.x here), so a net9.0-* inner build would ask for Microsoft.Maui.Controls
       10.0.x — a package with no net9.0-* lib, which fails restore with NU1202. The
       MAUI workload sets MauiVersion only when it is empty, so pinning it here wins.

       This has to be conditioned on $(TargetFramework), which is empty in the outer
       build of a multi-targeted project and set in every inner build. Restore evaluates
       per TFM, so the condition is live where it matters. -->
  <PropertyGroup>
    <!-- The floor, not a preference. A PackageReference version is a minimum, so whatever
         is set here becomes the lowest Microsoft.Maui.Controls a net9 consumer is allowed
         to use — and picking "latest 9.0.x" silently forced every consumer to upgrade.
         The plugin only needs MauiAppBuilder, ConfigureLifecycleEvents and MainThread,
         all present in 9.0.0, so the floor sits there and consumers pick their own 9.0.x.
         Note this has nothing to do with Xcode: MAUI 9's iOS dependency group is
         net9.0-ios18.0 at every 9.0.x, so the MAUI version never pulls the platform
         version — and therefore the required Xcode — up. That is decided by the installed
         iOS workload pack instead. -->
    <IntercomMauiVersionNet9>9.0.0</IntercomMauiVersionNet9>
    <MauiVersion Condition="$(TargetFramework.StartsWith('net9.0'))">$(IntercomMauiVersionNet9)</MauiVersion>
  </PropertyGroup>

  <!-- NETSDK1202: "the workload 'net9.0-android' is out of support". Known and
       deliberate — see the TFM matrix note above. Suppressed rather than left to shout
       on every build, because Release builds promote warnings to errors in the plugin. -->
  <PropertyGroup>
    <NoWarn>$(NoWarn);NETSDK1202</NoWarn>
  </PropertyGroup>

  <!-- Centrally pinned tool/SDK versions.
       Change these in one place; eng/ scripts and CI read them from here. -->
  <PropertyGroup>
    <!-- Intercom iOS SDK version vendored at src/macios/Intercom.iOS.Binding/Intercom.xcframework -->
    <IntercomIosSdkVersion>19.7.2</IntercomIosSdkVersion>
    <!-- Intercom Android SDK version vendored in src/android/Intercom.Android.Binding/Jars -->
    <IntercomAndroidSdkVersion>18.7.0</IntercomAndroidSdkVersion>
    <!-- Ably realtime closure vendored in src/android/Intercom.Android.Ably/Jars.
         Intercom Android's POM asks for io.ably:ably-android, but it only touches core
         ably-java types, so we vendor ably-java and avoid a Firebase Messaging dependency.
         Keep ably-java in step with what the pinned Intercom SDK expects. -->
    <AblyJavaSdkVersion>1.7.2</AblyJavaSdkVersion>
    <AblyNetworkClientVersion>1.7.2</AblyNetworkClientVersion>
    <MsgpackCoreVersion>0.9.11</MsgpackCoreVersion>
    <VcdiffCoreVersion>0.1.1</VcdiffCoreVersion>
    <!-- swift-dotnet-bindings MSBuild project SDK version is pinned in global.json (msbuild-sdks).
         This property mirrors it for scripts/CI that need the value without JSON parsing. -->
    <SwiftBindingsSdkVersion>0.19.0</SwiftBindingsSdkVersion>
  </PropertyGroup>
</Project>
